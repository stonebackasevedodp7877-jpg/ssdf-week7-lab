# HealthSync - starter project build, recreated from the Week 7 slides.
#
# The Lab 7 starter zip and handout could not be found, so this file rebuilds
# the starter build the slides describe: build date from the wall clock, no
# -trimpath, release archive packed with the host's tar/gzip.
#
# Used only by TASK 1 ("Break It") in run_lab.sh:
#     make -f reference/Makefile.starter release
# Building the same commit twice with this file gives different SHA-256s.
# Root causes and fixes: build_drift_findings.md. The fixed build is ../Makefile.

VERSION    := 1.0.0
BUILD_DATE := $(shell date -u +%Y-%m-%dT%H:%M:%SZ)
COMMIT     := $(shell git rev-parse HEAD)
DIST       ?= dist
TARGETS    := linux/amd64 darwin/arm64

.PHONY: release clean

release:
	rm -rf $(DIST) && mkdir -p $(DIST)
	for t in $(TARGETS); do \
	  os=$${t%/*}; arch=$${t#*/}; pkg=healthsync-$(VERSION)-$$os-$$arch; \
	  mkdir -p $(DIST)/$$pkg || exit 1; \
	  GOOS=$$os GOARCH=$$arch go build \
	    -ldflags "-X main.version=$(VERSION) -X main.commit=$(COMMIT) -X main.buildDate=$(BUILD_DATE)" \
	    -o $(DIST)/$$pkg/healthsync ./cmd/healthsync || exit 1; \
	  cp README.md LICENSE $(DIST)/$$pkg/ || exit 1; \
	  tar -czf $(DIST)/$$pkg.tar.gz -C $(DIST) $$pkg || exit 1; \
	done
	cd $(DIST) && shasum -a 256 *.tar.gz

clean:
	rm -rf $(DIST)
